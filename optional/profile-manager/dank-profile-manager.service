[Unit]
Description=Dank CPU GPU and cooling profile manager
After=lactd.service coolercontrold.service power-profiles-daemon.service
Wants=lactd.service coolercontrold.service power-profiles-daemon.service

[Service]
Type=simple
ExecStart=/usr/bin/python -I /usr/local/lib/dank-profile-manager/manager.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=dank-profile-manager
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
